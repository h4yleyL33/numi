rules_version = '2';

// Rancangan aturan untuk FirestoreNumiRepository. Belum dipasang karena proyek Firebase
// tim belum dibuat. Strukturnya mengikuti ERD-001: satu dokumen per siswa, dan setiap
// entitas milik siswa disimpan sebagai subkoleksi.
//
// users/{uid}
//   skillMap/{topikId}, diagnosticResult/{topikId}, lessonProgress/{lessonId},
//   masteryResult/{id}, jawaban/{id}, siswaBadge/{badgeId}, streakLog/{tanggal},
//   companionMessage/{id}
// konten/{topikId}  (topik, lesson, dan templat soal, hanya dibaca aplikasi)

service cloud.firestore {
  match /databases/{database}/documents {

    // Data anak hanya bisa dibaca dan ditulis oleh akunnya sendiri (NFR-005).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{koleksi}/{dokumen} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Konten belajar diisi tim lewat konsol, aplikasi hanya membaca.
    match /konten/{dokumen=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
